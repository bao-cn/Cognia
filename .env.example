# Copy to .env and replace every secret before exposing the stack.
DB_NAME=cognia
DB_USER=cognia
DB_PASSWORD=change-this-database-password

# At least 32 bytes each. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes
SETTINGS_SECRET=change-this-settings-secret-at-least-32-chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com

MINIO_ROOT_USER=cognia
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=cognia

# Browser origins allowed to call the API directly (the frontend proxy does not need CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Copy to .env and replace every secret before exposing the stack.
DB_NAME=cognia
DB_USER=cognia
DB_PASSWORD=change-this-database-password

# At least 32 bytes each. Generate with: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes
SETTINGS_SECRET=change-this-settings-secret-at-least-32-chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com

MINIO_ROOT_USER=cognia
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=cognia

# Browser origins allowed to call the API directly (the frontend proxy does not need CORS).
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Optional local Ollama stack: docker compose --profile ollama up -d
# Leave OLLAMA_BASE_URL empty when Ollama is not deployed.
OLLAMA_BASE_URL=

# Billing payment webhook HMAC-SHA256 secrets.
# Keep these independent for every provider. Generate one with:
# openssl rand -hex 32
# The backend verifies X-Cognia-Signature against the raw JSON request body.
# Leave an unused provider empty; the webhook then refuses requests for that provider.
BILLING_ALIPAY_WEBHOOK_SECRET=
BILLING_WECHAT_WEBHOOK_SECRET=
BILLING_STRIPE_WEBHOOK_SECRET=

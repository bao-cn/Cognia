# API base URL. In development the Vite proxy forwards /api to Spring Boot.
VITE_API_BASE_URL=/api/v1

# Optional: override the proxy target used by `vite` (not used in production).
# VITE_PROXY_TARGET=http://localhost:8080

# Desktop builds load .env.desktop and require an absolute API origin.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
